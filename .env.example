# Copy to .env (or paste into Portainer's environment variables) and fill in.

# Where the site is published. The frontend container listens on this host port.
FRONTEND_PORT=8088
# Public origin of the site. Used for CORS and as the WebAuthn origin,
# so it must match exactly what the browser shows, including scheme and port.
PUBLIC_URL=http://localhost:8088
# Passkey relying-party id: the bare domain, no scheme or port ("localhost" for local).
WEBAUTHN_RP_ID=localhost

# Image tags to deploy (latest, 1.2.3, main, sha-abc1234, ...)
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Leave empty to let nginx proxy /api to the backend over the internal network.
# Only set this if you serve the API from a different origin.
API_URL=

# --- secrets ---------------------------------------------------------------
# openssl rand -hex 48
JWT_SECRET=
POSTGRES_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me-too
ADMIN_EMAIL=admin@dichtbij3d.nl
ADMIN_PASSWORD=change-me-now

# --- optional --------------------------------------------------------------
POSTGRES_DB=dichtbij3d
POSTGRES_USER=dichtbij3d
MINIO_ROOT_USER=dichtbij3d
MINIO_BUCKET=dichtbij3d
MINIO_CONSOLE_PORT=9001
# Seed demo users and adverts on an empty database.
DEMO_DATA=false
