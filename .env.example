# ==============================================================================
# Dichtbij3D Stack Environment Variables (Portainer / Docker Compose)
# ==============================================================================

# --- Domain & Public URL ---
SUBDOMAIN=dichtbij3d-tst
PUBLIC_URL=https://dichtbij3d-tst.clovercloud.cc
FRONTEND_PORT=8088

# --- Database (PostgreSQL) ---
POSTGRES_DB=dichtbij3d
POSTGRES_USER=dichtbij3d
POSTGRES_PASSWORD=dichtbij3d

# --- MinIO Object Storage (S3 compatible) ---
MINIO_ROOT_USER=dichtbij3d
MINIO_ROOT_PASSWORD=dichtbij3d-secret
MINIO_BUCKET=dichtbij3d
MINIO_CONSOLE_PORT=9001

# --- Security & JWT ---
# Provide a secure random secret of at least 64 characters in production
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789-abcdefghijklmnopqrstuvwxyz
WEBAUTHN_RP_ID=dichtbij3d-tst.clovercloud.cc

# --- Bootstrap Admin ---
ADMIN_EMAIL=admin@dichtbij3d.nl
ADMIN_PASSWORD=Admin123!
DEMO_DATA=false

# --- Email / SMTP Settings (Google Workspace, SendGrid, etc.) ---
# For Google Workspace: generate a 16-char App Password at myaccount.google.com -> Security -> 2FA -> App Passwords
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=jouw-account@jordydevrix.com
SPRING_MAIL_PASSWORD=jouw-16-letter-app-wachtwoord
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true

# --- Mail Sender Branding ---
MAIL_FROM=noreply@jordydevrix.com
MAIL_FROM_NAME=Dichtbij3D
FRONTEND_URL=https://dichtbij3d-tst.clovercloud.cc
MAIL_RESET_TOKEN_TTL=PT30M
